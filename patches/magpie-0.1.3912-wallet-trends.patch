+// Wallets share neither a quota nor a reset. Sum their observed balances
+// only over their common history, carrying the last reading of each forward.
+// Failed/stale accounts make a full total unknown rather than zero.
+function walletTotals(subs) {
+  if (subs.some((q) => q.error || q.asOf)) return [];
+  const groups = new Map();
+  for (const q of subs) {
+    const seen = new Set();
+    for (const w of q.windows || []) {
+      if (w.balance == null || w.text) continue;
+      const key = JSON.stringify([w.name, w.unit || "", w.pool || "", w.family || ""]);
+      if (seen.has(key)) return [];
+      seen.add(key);
+      if (!groups.has(key)) groups.set(key, []);
+      groups.get(key).push(w);
+    }
+  }
+  const out = [];
+  for (const ws of groups.values()) {
+    if (ws.length !== subs.length) continue;
+    const lines = ws.map((w) => (w.balanceTrend?.points || []).map((p) => ({ at: Date.parse(p.at), amount: p.amount }))
+      .filter((p) => Number.isFinite(p.at) && Number.isFinite(p.amount)).sort((a, b) => a.at - b.at));
+    if (lines.some((ps) => !ps.length)) continue;
+    const start = Math.max(...lines.map((ps) => ps[0].at));
+    const times = [...new Set(lines.flatMap((ps) => ps.map((p) => p.at)))].filter((at) => at >= start).sort((a, b) => a - b);
+    const indices = lines.map(() => 0);
+    const points = times.map((at) => {
+      let amount = 0;
+      lines.forEach((ps, i) => { while (indices[i] + 1 < ps.length && ps[indices[i] + 1].at <= at) indices[i]++; amount += ps[indices[i]].amount; });
+      return { at: new Date(at).toISOString(), amount };
+    });
+    out.push({ ...ws[0], balance: ws.reduce((n, w) => n + w.balance, 0), balanceTrend: { points } });
+  }
+  return out;
+}
