+package provider
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// noteWalletHistory records each prepaid window separately. The identity
+// includes the window and its unit so a renamed wallet or changed currency
+// never inherits another series. ReadAt and AsOf keep cached reads from
+// becoming fresh samples. Storage, retention and fitting match key balances.
+func noteWalletHistory(qs []SubscriptionQuota, now time.Time) {
+	type position struct{ card, window int }
+	var cards []SubscriptionQuota
+	var positions []position
+	for i, q := range qs {
+		if q.Provider == "" || q.Estimate != nil {
+			continue
+		}
+		for j, w := range q.Windows {
+			if w.Balance == nil || w.Text || math.IsNaN(*w.Balance) || math.IsInf(*w.Balance, 0) {
+				continue
+			}
+			identity, _ := json.Marshal([]string{strings.ToLower(q.User), w.Name, w.Unit, w.Family, w.Pool, w.Model})
+			c := q
+			c.Provider = "@wallet:" + q.Provider
+			c.User = fmt.Sprintf("%x", sha256.Sum256(identity))
+			c.Balance = strconv.FormatFloat(*w.Balance, 'f', -1, 64)
+			c.BalanceParts = nil
+			c.BalanceTrend = nil
+			cards = append(cards, c)
+			positions = append(positions, position{i, j})
+		}
+	}
+	if len(cards) == 0 {
+		return
+	}
+	noteBalanceHistory(cards, now)
+	for i, at := range positions {
+		tr := cards[i].BalanceTrend
+		if tr == nil {
+			// A first real reading is a point, not an invented flat past.
+			pts := readWalletPoints(cards[i], now)
+			if len(pts) == 1 {
+				tr = &BalanceTrend{Points: pts}
+			}
+		}
+		qs[at.card].Windows[at.window].BalanceTrend = tr
+	}
+}
+
+func readWalletPoints(q SubscriptionQuota, now time.Time) []BalancePoint {
+	balanceHistMu.Lock()
+	defer balanceHistMu.Unlock()
+	pts := readBalanceHist()[quotaHistKey(q.Provider, q.User)]
+	if len(pts) == 1 && !pts[0].At.Before(now.Add(-balanceShowSpan)) {
+		return pts
+	}
+	return nil
+}
