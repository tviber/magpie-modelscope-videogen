+package provider
+
+import (
+	"github.com/yetone/magpie/internal/testenv"
+	"testing"
+	"time"
+)
+
+func TestWalletHistoryAccountIsolationAndReport(t *testing.T) {
+	testenv.SetHome(t, t.TempDir())
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	start := time.Date(2026, 11, 12, 12, 0, 0, 0, time.UTC)
+	card := func(user, unit string, n float64) SubscriptionQuota {
+		return SubscriptionQuota{Provider: "wan", User: user, Windows: []QuotaWindow{{Name: "可用魔粒", Unit: unit, Balance: &n}}}
+	}
+	noteCardHistory([]SubscriptionQuota{card("a", "魔粒", 300), card("b", "魔粒", 200)}, start)
+	qs := []SubscriptionQuota{card("a", "魔粒", 290), card("b", "魔粒", 180), card("a", "USD", 999)}
+	noteCardHistory(qs, start.Add(10*time.Minute))
+	for i, want := range []float64{290, 180} {
+		tr := qs[i].Windows[0].BalanceTrend
+		if tr == nil || len(tr.Points) != 2 || tr.Points[1].Amount != want {
+			t.Fatalf("account %d lost its wallet readings: %+v", i, tr)
+		}
+	}
+	if tr := qs[2].Windows[0].BalanceTrend; tr == nil || len(tr.Points) != 1 || tr.Points[0].Amount != 999 {
+		t.Fatal("changed units inherited a different wallet")
+	}
+	report := quotaReport(qs, nil, nil, start.Add(10*time.Minute))
+	if report[0].Windows[0].BalanceTrend == nil {
+		t.Fatal("usage API dropped wallet history")
+	}
+	stale := card("a", "魔粒", 1)
+	stale.AsOf = &start
+	noteCardHistory([]SubscriptionQuota{stale}, start.Add(20*time.Minute))
+	bad := card("a", "魔粒", 0)
+	bad.Error = "offline"
+	noteCardHistory([]SubscriptionQuota{bad}, start.Add(30*time.Minute))
+	fresh := []SubscriptionQuota{card("a", "魔粒", 280)}
+	noteCardHistory(fresh, start.Add(40*time.Minute))
+	tr := fresh[0].Windows[0].BalanceTrend
+	if len(tr.Points) != 3 || tr.Points[1].Amount != 290 {
+		t.Fatalf("failed or stale read became history: %+v", tr)
+	}
+	if _, ok := pointOf(fresh[0].Windows[0], start, start); ok {
+		t.Fatal("wallet was recorded as a fictitious percentage")
+	}
+	if fresh[0].Balance != "" {
+		t.Fatal("wallet chart introduced duplicate top-level balance")
+	}
+}
