+package gateway
+
+import (
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/usage"
+)
+
+type pluginRouteKey struct{}
+type pluginRouteCaller struct {
+	s *Server
+	r *http.Request
+}
+
+// runRoutedPluginTool records only tools that explicitly opt in. Both MCP
+// entry points and the Library hub use this path. It observes one tool call,
+// never repeats it, and never treats accepting a job as finishing its video.
+func (s *Server) runRoutedPluginTool(r *http.Request, spec string, def plugin.Tool, args json.RawMessage, agent string) (string, error) {
+	if def.Route == nil {
+		return runPluginTool(r.Context(), spec, def.Name, args, agent)
+	}
+	start := time.Now()
+	var in map[string]json.RawMessage
+	_ = json.Unmarshal(args, &in)
+	model := def.Route.DefaultModel
+	if b := in[def.Route.ModelArg]; len(b) > 0 {
+		var m string
+		if json.Unmarshal(b, &m) == nil && m != "" && len(m) <= 160 {
+			model = m
+		}
+	}
+	pid := provider.PluginID(def.Route.Provider)
+	mcpUseOf(r.Context()).used(pid, model)
+	name := def.Route.Provider
+	if p, e := provider.Find(pid); e == nil && p.Name != "" {
+		name = p.Name
+	}
+	rt := s.trace.beginFor(r, Route{Time: start, Agent: agent, Session: sessionOf(r.Header), Kind: usage.KindMCP, Model: pid + "/" + model, Provider: pid, Order: []Weighed{{ID: pid, Provider: pid, Name: name, Kind: "provider", Model: model}}, Tries: []Try{{ID: pid, Model: model, Start: start, SentBy: "plugin"}}})
+	said, err := runPluginTool(r.Context(), spec, def.Name, args, agent)
+	status := http.StatusOK
+	why := ""
+	if err != nil {
+		status = http.StatusBadGateway
+		why = err.Error()
+		if r.Context().Err() != nil {
+			status = usage.StatusCanceled
+			why = usage.AgentCanceled
+		}
+	}
+	// Only these identifiers describe the submission; arbitrary tool output,
+	// prompts, frame paths, provider URLs and authentication never enter the log.
+	var result struct {
+		ID      string `json:"id"`
+		Status  string `json:"status"`
+		Account string `json:"account_id"`
+	}
+	_ = json.Unmarshal([]byte(said), &result)
+	result.ID = cutName(result.ID, 200)
+	result.Status = cutName(result.Status, 64)
+	result.Account = cutName(result.Account, 100)
+	response, _ := json.Marshal(map[string]any{"operation": "video_submission", "job_id": result.ID, "job_status": result.Status, "account_id": result.Account, "generation_completed": result.Status == "completed"})
+	request, _ := json.Marshal(map[string]string{"tool": def.Name, "model": model, "operation": "video_submission"})
+	ms := time.Since(start).Milliseconds()
+	s.record(Call{Route: rt.ID, Time: start, Agent: agent, Kind: usage.KindMCP, Model: model, Provider: pid, From: "mcp", To: "plugin", Status: status, Millis: ms, Error: why, RequestBody: string(request), ResponseBody: string(response)})
+	s.trace.update(rt, func(t *Route) {
+		t.Done, t.Status, t.Millis, t.Error = true, status, ms, why
+		t.ResponseID = result.ID
+		t.Tries[0].Done, t.Tries[0].Status, t.Tries[0].Millis, t.Tries[0].Error = true, status, ms, why
+		if result.Account != "" {
+			t.Order[0].Who = result.Account
+			t.Order[0].ID = pid + "@" + result.Account
+			t.Order[0].Kind = "account"
+			t.Tries[0].ID = t.Order[0].ID
+		}
+	})
+	return said, err
+}
