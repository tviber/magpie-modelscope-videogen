+func TestPluginVideoSubmissionRoutes(t *testing.T) {
+	fresh(t)
+	def := plugin.Tool{Name: "wan_generate_i2v", Route: &plugin.ToolRoute{Provider: "modelscope-wan", ModelArg: "model", DefaultModel: "wan2.2-i2v-a14b"}}
+	fakePluginTools(t, []plugin.PluginTools{{Spec: "/plugins/magpie-modelscope-wan", Tools: []plugin.Tool{def, {Name: "wan_get_video_status"}}}})
+	old := runPluginTool
+	calls := 0
+	runPluginTool = func(context.Context, string, string, json.RawMessage, string) (string, error) {
+		calls++
+		return `{"id":"wan-job-123","status":"queued","account_id":"account-2","prompt":"private prompt","first_frame":"/private/frame.png"}`, nil
+	}
+	t.Cleanup(func() { runPluginTool = old })
+	s := New()
+	w := toolsPost(s.Handler(), toolsCall("magpie-modelscope-wan_wan_generate_i2v", `{"model":"wan2.2-ti2v-5b","prompt":"private prompt"}`), "User-Agent", "codex/1.0", SessionHeader, "session-video")
+	m := readMCP(t, w)
+	if m.Result.IsError {
+		t.Fatalf("submission: %s", w.Body)
+	}
+	rows := s.Trace(context.Background(), 0, 0).Routes
+	if len(rows) != 1 {
+		t.Fatalf("video submission missing from Routing: %+v", rows)
+	}
+	rt := rows[0]
+	if rt.ResponseID != "wan-job-123" {
+		t.Fatalf("durable job ID missing: %+v", rt)
+	}
+	if !rt.Done || rt.Status != 200 || rt.Model != "modelscope-wan/wan2.2-ti2v-5b" || rt.Agent != "codex" || rt.Session != "session-video" || len(rt.Tries) != 1 || rt.Order[0].Who != "account-2" {
+		t.Fatalf("route: %+v", rt)
+	}
+	call, ok := s.RouteCall(rt.ID)
+	if !ok || !strings.Contains(call.ResponseBody, `"job_status":"queued"`) || !strings.Contains(call.ResponseBody, `"generation_completed":false`) || strings.Contains(call.RequestBody+call.ResponseBody, "private") {
+		t.Fatalf("submission result: %+v", call)
+	}
+	toolsPost(s.Handler(), toolsCall("magpie-modelscope-wan_wan_get_video_status", `{"job_id":"wan-job-123"}`))
+	if len(s.Trace(context.Background(), 0, 0).Routes) != 1 || calls != 2 {
+		t.Fatal("poll duplicated submission route or tool was repeated")
+	}
+	runPluginTool = func(context.Context, string, string, json.RawMessage, string) (string, error) {
+		return "", errors.New("frame cannot be read")
+	}
+	_, err := s.runRoutedPluginTool(httptest.NewRequest("POST", "/mcp", nil), "/plugins/magpie-modelscope-wan", def, nil, "claude")
+	rows = s.Trace(context.Background(), 0, 0).Routes
+	if err == nil || len(rows) != 2 || rows[1].Status != 502 || rows[1].Error != "frame cannot be read" {
+		t.Fatalf("failure lost: %+v %v", rows, err)
+	}
+}
+
+func TestPluginVideoSubmissionRoutesThroughHub(t *testing.T) {
+	fresh(t)
+	def := plugin.Tool{Name: "wan_generate_i2v", Route: &plugin.ToolRoute{Provider: "modelscope-wan", DefaultModel: "wan2.2-i2v-a14b"}}
+	fakePluginTools(t, []plugin.PluginTools{{Spec: "magpie-modelscope-wan", Tools: []plugin.Tool{def}}})
+	old := MCPHub
+	MCPHub = &fakeHub{on: true, call: func(ctx context.Context, server, tool string) (json.RawMessage, error) {
+		said, err := RunPluginToolOf(ctx, "magpie-modelscope-wan", tool, json.RawMessage(`{}`), "codex")
+		if err != nil {
+			return nil, err
+		}
+		return json.Marshal(map[string]string{"text": said})
+	}}
+	t.Cleanup(func() { MCPHub = old })
+	s := New()
+	r := httptest.NewRequest("POST", "/mcp/magpie/hub/codex", nil)
+	r.Header.Set(SessionHeader, "hub-video")
+	s.hubMCPRun(r, "codex", hubTool{HubTool: HubTool{Server: "wan", Tool: "wan_generate_i2v"}, name: "wan__wan_generate_i2v"}, json.RawMessage(`{}`))
+	rows := s.Trace(context.Background(), 0, 0).Routes
+	if len(rows) != 1 || rows[0].Agent != "codex" || rows[0].Session != "hub-video" {
+		t.Fatalf("hub submission missing or duplicated: %+v", rows)
+	}
+}
+
+func TestPluginVideoRouteCallerAndCanceled(t *testing.T) {
+	fresh(t)
+	fakePluginTools(t, nil)
+	old := runPluginTool
+	runPluginTool = func(context.Context, string, string, json.RawMessage, string) (string, error) {
+		return "", context.Canceled
+	}
+	t.Cleanup(func() { runPluginTool = old })
+	ctx, cancel := context.WithCancel(access.WithIdentity(context.Background(), access.Identity{KeyID: "caller-key", KeyName: "Laptop"}))
+	cancel()
+	r := httptest.NewRequest("POST", "/mcp", nil).WithContext(ctx)
+	s := New()
+	_, err := s.runRoutedPluginTool(r, "wan", plugin.Tool{Name: "submit", Route: &plugin.ToolRoute{Provider: "modelscope-wan", DefaultModel: "wan-test"}}, nil, "codex")
+	rows := s.Trace(context.Background(), 0, 0).Routes
+	if err == nil || len(rows) != 1 || rows[0].CallerKey != "caller-key" || rows[0].CallerKeyName != "Laptop" || rows[0].Status != 499 || !rows[0].Canceled {
+		t.Fatalf("canceled caller: %+v %v", rows, err)
+	}
+}
